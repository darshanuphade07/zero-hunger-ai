# AgriSmart AI – Zero Hunger
# Environment Variables Example

# Optional Google Gemini API Key for dynamic leaf vision diagnosis and conversational AI
# If omitted, AgriSmart operates in 100% Free Offline Demo Simulation Mode
GEMINI_API_KEY=

# Backend Host & Port
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./agrismart.db

# Frontend API URL (defaults to http://127.0.0.1:8000/api)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
